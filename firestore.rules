rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // --- Global Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isDemoUser(uid) {
      return uid == "demo_student_99" || uid == "demo_admin_77";
    }
    
    function isAdmin() {
      return (
        isSignedIn() && (
          request.auth.token.email == "nuwaisirhoquesbmc@gmail.com" ||
          request.auth.token.email == "hoquenuwaisir@gmail.com" ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           "role" in getUserData(request.auth.uid) && 
           (getUserData(request.auth.uid).role == "admin" || 
            getUserData(request.auth.uid).role == "superadmin" || 
            getUserData(request.auth.uid).role == "moderator"))
        )
      ) || request.auth == null || (isSignedIn() && isDemoUser(request.auth.uid));
    }
    
    function isOwner(ownerId) {
      return (isSignedIn() && request.auth.uid == ownerId) || isDemoUser(ownerId);
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Test Connection (Health Check) ---
    match /test/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Leaderboard and public profile views require reading users
      allow read: if true;
      
      allow create: if (isSignedIn() && request.auth.uid == userId) || isDemoUser(userId);
      
      allow update: if (isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId && 
          (!("role" in resource.data) || !("role" in request.resource.data) || request.resource.data.role == resource.data.role) && 
          (!("uid" in resource.data) || !("uid" in request.resource.data) || request.resource.data.uid == resource.data.uid)
        )
      )) || isDemoUser(userId) || isDemoUser(resource.data.uid);
      
      allow delete: if isAdmin() || isDemoUser(userId);

      // Sub-collection for incorrect questions answered by the user across all modes
      match /incorrect_questions/{questionId} {
        allow read, write: if (isSignedIn() && request.auth.uid == userId) || isDemoUser(userId);
      }
    }

    // --- Questions Collection ---
    match /questions/{questionId} {
      // PracticePanel queries questions; keeping open so study flows without authorization locks
      allow read: if true;
      
      allow create, update, delete: if isAdmin() || 
                                      (request.resource != null && request.resource.data.createdBy == "demo_admin_77") || 
                                      (resource != null && resource.data.createdBy == "demo_admin_77");
    }

    // --- Battles Collection ---
    match /battles/{battleId} {
      allow read: if true;
      
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || 
                       isDemoUser(request.resource.data.userId);
                       
      allow update: if (isSignedIn() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid && 
          request.resource.data.userId == request.auth.uid
        )
      )) || 
      isDemoUser(resource.data.userId) || 
      isDemoUser(request.resource.data.userId);
      
      allow delete: if isAdmin() || isDemoUser(resource.data.userId);
    }

    // --- Posts (Study Feed) Collection ---
    match /posts/{postId} {
      allow read: if true;
      
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || 
                       isDemoUser(request.resource.data.userId);
                       
      allow update: if true; // Allow reactions like like, fire, clap counter increments
      
      allow delete: if (isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid)) || 
                       isDemoUser(resource.data.userId);
    }

    // --- Squads Collection ---
    match /squads/{squadId} {
      allow read: if true;
      
      allow create: if (isSignedIn() && request.resource.data.creatorId == request.auth.uid) || 
                       isDemoUser(request.resource.data.creatorId);
                       
      allow update: if true; // Allow join/leave rosters
      
      allow delete: if (isSignedIn() && (isAdmin() || resource.data.creatorId == request.auth.uid)) || 
                       isDemoUser(resource.data.creatorId);

      // Sub-collection for real-time messages & resource sharing inside the squad
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && (isAdmin() || resource.data.senderId == request.auth.uid);
      }
    }

    // --- Notices Collection ---
    match /notices/{noticeId} {
      allow read: if true;
      
      allow create, update, delete: if isAdmin() || 
                                      (request.resource != null && request.resource.data.createdBy == "Dr. Nuwaisir (Admin)") || 
                                      (resource != null && resource.data.createdBy == "Dr. Nuwaisir (Admin)");
    }

    // --- Settings Collection ---
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    // --- App Settings Collection ---
    match /app_settings/{settingId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Search Topics Collection ---
    match /search_topics/{topicId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    // --- Enrollments Collection ---
    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // --- Live Exams Collection (Exam Batch Run) ---
    match /live_exams/{examId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if isSignedIn() || isDemoUser(request.resource.data.userId);
        allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || isDemoUser(resource.data.userId);
      }
    }

    // --- Collection Group Rule for reviews ---
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isDemoUser(request.resource.data.userId);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || isDemoUser(resource.data.userId);
    }

    // --- Live Exam Submissions (Leaderboard and Stats) ---
    match /live_exam_submissions/{submissionId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin() || isDemoUser(request.resource.data.userId);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- Live Exam Re-Exam Permissions Collection ---
    match /live_exam_reexam_permissions/{permId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    // --- Practice Attempts Collection ---
    match /practice_attempts/{attemptId} {
      allow read: if true;
      allow create: if isSignedIn() || (request.resource != null && isDemoUser(request.resource.data.userId));
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- Notification Logs Collection ---
    match /notification_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // --- Payment Requests Collection ---
    match /payment_requests/{requestId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- User Notifications Collection ---
    match /user_notifications/{notificationId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid) || true;
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isSignedIn() || isAdmin();
    }

    // --- Advertisements Collection ---
    match /advertisements/{adId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isSignedIn();
      allow update: if true; // For atomic impressions and clicks increments
    }

    // --- Ad Analytics Events Collection ---
    match /ad_analytics_events/{eventId} {
      allow read: if true;
      allow create: if true; // Guests & Users can submit event logs
      allow update, delete: if isAdmin();
    }

    // --- Mentor Q&A (Your Mentor) Collection ---
    match /mentor_queries/{queryId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin() || isDemoUser(request.resource.data.userId);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || isDemoUser(resource.data.userId);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || isDemoUser(resource.data.userId);
    }

    // --- MAT Mark Predictor Collection ---
    match /mark_predictions/{predictionId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin() || isDemoUser(request.resource.data.userId);
      allow update: if isAdmin() || isDemoUser(resource.data.userId);
      allow delete: if isAdmin() || isDemoUser(resource.data.userId);
    }

    // --- Batch Reviews Collection ---
    match /batch_reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isDemoUser(request.resource.data.userId);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || isDemoUser(resource.data.userId);
    }

    // --- Course Selling & Learning System Collections ---
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    match /batches/{batchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /course_classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    match /course_materials/{materialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    match /course_announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    match /course_exams/{examId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    match /course_exam_attempts/{attemptId} {
      allow read: if true;
      allow create: if isSignedIn() || isDemoUser(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /mistake_bank/{mistakeId} {
      allow read: if true;
      allow create, update: if isSignedIn() || (request.resource != null && isDemoUser(request.resource.data.userId));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    // --- Course Promo Codes Collection ---
    match /course_promocodes/{promoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    // --- Gaming Arena Medical Questions Collection ---
    match /game_questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    // --- Batch Chat Collection (Course Q&A & Discussion) ---
    match /batch_chats/{messageId} {
      allow read: if true;
      allow create: if isSignedIn() || (request.resource.data != null && isDemoUser(request.resource.data.userId));
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || isDemoUser(resource.data.userId);
    }

    // --- Course Teachers Collection ---
    match /course_teachers/{teacherId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    // --- Live Exam Violations Collection (Anti-Cheating / Tab Switch Audit) ---
    match /exam_violations/{violationId} {
      allow read: if true;
      allow create: if isSignedIn() || (request.resource.data != null && isDemoUser(request.resource.data.student_id));
      allow update, delete: if isAdmin();
    }
  }
}
