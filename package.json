{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "find-files": "node -e \"const fs = require('fs'); console.log('CWD:', process.cwd()); const listDirs = (p) => { try { console.log('Listing:', p, fs.readdirSync(p)); } catch(e){ console.log('Err reading:', p, e.message); } }; listDirs('.'); listDirs('..'); listDirs('/tmp'); \"",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "migrate:seed": "tsx scripts/seed_supabase.ts",
    "migrate:verify": "tsx scripts/verify_schema.ts",
    "migrate:run": "tsx scripts/migrate_to_supabase.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
