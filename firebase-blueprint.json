{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with gamified student parameters",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "college": { "type": "string" },
        "district": { "type": "string" },
        "level": { "type": "integer" },
        "xp": { "type": "integer" },
        "coins": { "type": "integer" },
        "rank": { "type": "string" },
        "dailyStreak": { "type": "integer" },
        "lastActiveDate": { "type": "string" },
        "questionsSolved": { "type": "integer" },
        "questionsCorrect": { "type": "integer" },
        "avatarUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "moderator", "admin", "superadmin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "phoneNumber": { "type": "string" }
      },
      "required": ["uid", "displayName", "email", "role"]
    },
    "Question": {
      "title": "MCQ Question",
      "description": "Medical admission preparation multiple choice question",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "questionText": { "type": "string" },
        "options": { "type": "array" },
        "correctAnswerIndex": { "type": "integer" },
        "explanation": { "type": "string" },
        "subject": { "type": "string" },
        "chapter": { "type": "string" },
        "difficulty": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["questionText", "options", "correctAnswerIndex", "subject", "chapter", "difficulty"]
    },
    "Battle": {
      "title": "MCQ Battle Session",
      "description": "Active practice session represented as a game battle against an enemy/boss",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "battleType": { "type": "string", "enum": ["standard", "boss", "survival", "challenge"] },
        "opponentName": { "type": "string" },
        "opponentMaxHp": { "type": "integer" },
        "opponentHp": { "type": "integer" },
        "playerMaxHp": { "type": "integer" },
        "playerHp": { "type": "integer" },
        "questionsCount": { "type": "integer" },
        "currentIndex": { "type": "integer" },
        "combo": { "type": "integer" },
        "goldEarned": { "type": "integer" },
        "xpEarned": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "won", "lost", "fled"] },
        "questionIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "battleType", "status", "playerHp", "opponentHp"]
    },
    "Post": {
      "title": "Social Feed Post",
      "description": "Progress/achievement update shared by students in the Study Feed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userDisplayName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "userRank": { "type": "string" },
        "content": { "type": "string" },
        "achievementType": { "type": "string" },
        "streakCount": { "type": "integer" },
        "likes": { "type": "integer" },
        "fires": { "type": "integer" },
        "claps": { "type": "integer" },
        "likedBy": { "type": "array" },
        "firedBy": { "type": "array" },
        "clappedBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isDoubt": { "type": "boolean" },
        "doubtSubject": { "type": "string" },
        "doubtChapter": { "type": "string" },
        "doubtImageUrl": { "type": "string" },
        "doubtSolved": { "type": "boolean" }
      },
      "required": ["userId", "userDisplayName", "content", "createdAt"]
    },
    "Squad": {
      "title": "Study Squad",
      "description": "Student teams for collective XP and challenges",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "logoUrl": { "type": "string" },
        "creatorId": { "type": "string" },
        "teamXp": { "type": "integer" },
        "memberCount": { "type": "integer" },
        "members": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "creatorId", "members", "createdAt"]
    },
    "SquadMessage": {
      "title": "Squad Chat Message",
      "description": "Real-time message and study resource shared by squad members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "content": { "type": "string" },
        "resourceTitle": { "type": "string" },
        "resourceUrl": { "type": "string" },
        "resourceType": { "type": "string", "enum": ["none", "link", "image", "document", "mnemonic"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "content", "createdAt"]
    },
    "Notice": {
      "title": "Admission Update / Platform Announcement",
      "description": "Medical admission news, updates, and platform events created by admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string", "enum": ["news", "update", "announcement", "event"] },
        "important": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "content", "category", "createdAt"]
    },
    "PlatformSettings": {
      "title": "Platform Settings",
      "description": "System configuration for the platform features",
      "type": "object",
      "properties": {
        "socialFeedEnabled": { "type": "boolean" },
        "aiMentorEnabled": { "type": "boolean" },
        "dailyMissionsEnabled": { "type": "boolean" },
        "bossBattlesEnabled": { "type": "boolean" },
        "survivalEnabled": { "type": "boolean" },
        "leaderboardEnabled": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "premiumControlMode": { "type": "string", "enum": ["all_free", "premium_locked", "trial_mode"] },
        "activeEvent": { "type": "string" },
        "landingVideoUrl": { "type": "string" },
        "landingVideoTitle": { "type": "string" },
        "landingVideoEnabled": { "type": "boolean" },
        "backgroundMusicUrl": { "type": "string" },
        "backgroundMusicTitle": { "type": "string" },
        "backgroundMusicEnabled": { "type": "boolean" },
        "backgroundMusicVolume": { "type": "number" }
      },
      "required": [
        "socialFeedEnabled",
        "aiMentorEnabled",
        "dailyMissionsEnabled",
        "bossBattlesEnabled",
        "survivalEnabled",
        "leaderboardEnabled",
        "maintenanceMode",
        "premiumControlMode",
        "activeEvent"
      ]
    },
    "Enrollment": {
      "title": "Enrollment Record",
      "description": "Student enrollment package, transaction information, and billing ledger logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userDisplayName": { "type": "string" },
        "packageName": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "trxId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "required": ["userId", "packageName", "amount", "paymentMethod", "trxId", "status", "createdAt"]
    },
    "LiveExam": {
      "title": "Live Exam",
      "description": "A live model test event hosted for an Exam Batch run",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "chapter": { "type": "string" },
        "duration": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "questionIds": { "type": "array" },
        "createdBy": { "type": "string" },
        "creatorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["title", "subject", "duration", "totalQuestions", "questionIds", "createdBy"]
    },
    "LiveExamSubmission": {
      "title": "Live Exam Submission",
      "description": "Student submission record and score for a live model test",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "examTitle": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "score": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "timeTaken": { "type": "integer" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "answers": { "type": "object" }
      },
      "required": ["examId", "userId", "displayName", "score", "totalQuestions", "timeTaken", "submittedAt"]
    },
    "PaymentRequest": {
      "title": "Payment Request",
      "description": "Manual subscription payment verification request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "selectedPlan": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "senderNumber": { "type": "string" },
        "transactionId": { "type": "string" },
        "amount": { "type": "number" },
        "screenshotUrl": { "type": "string" },
        "submissionDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "adminNotes": { "type": "string" }
      },
      "required": ["userId", "userName", "userEmail", "selectedPlan", "paymentMethod", "senderNumber", "transactionId", "amount", "status"]
    },
    "UserNotification": {
      "title": "User Notification",
      "description": "In-app notification for students regarding payments or achievements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content", "type", "read", "createdAt"]
    },
    "Advertisement": {
      "title": "Advertisement",
      "description": "Popup or banner advertisement configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "destinationUrl": { "type": "string" },
        "ctaText": { "type": "string" },
        "openMode": { "type": "string", "enum": ["same", "new"] },
        "loginPopupEnabled": { "type": "boolean" },
        "recurringPopupEnabled": { "type": "boolean" },
        "targetAudience": { "type": "string", "enum": ["all", "logged_in", "guests"] },
        "frequency": { "type": "integer" },
        "delay": { "type": "integer" },
        "autoCloseTime": { "type": "integer" },
        "width": { "type": "string" },
        "height": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" },
        "impressionsCount": { "type": "integer" },
        "clicksCount": { "type": "integer" }
      },
      "required": ["bannerUrl", "title", "destinationUrl", "status", "createdAt"]
    },
    "AdAnalyticsEvent": {
      "title": "Ad Analytics Event",
      "description": "Detailed log event for advertisement impressions and clicks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adId": { "type": "string" },
        "type": { "type": "string", "enum": ["impression", "click"] },
        "userId": { "type": "string" },
        "sessionOrDevice": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["adId", "type", "timestamp"]
    },
    "MentorQuery": {
      "title": "Mentor Query",
      "description": "Student question to mentor and admin reply",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "question": { "type": "string" },
        "reply": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "replied"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "repliedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "question", "status", "createdAt"]
    },
    "MarkPrediction": {
      "title": "Mark Prediction Request",
      "description": "Student details submitted for custom mark prediction and admin feedback",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "sscGpa": { "type": "number" },
        "hscGpa": { "type": "number" },
        "testScores": { "type": "number" },
        "predictedMark": { "type": "string" },
        "recommendedCollege": { "type": "string" },
        "comments": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "predicted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "predictedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "sscGpa", "hscGpa", "status", "createdAt"]
    },
    "PremiumConfig": {
      "title": "Premium Configuration",
      "description": "Subscription pricing and beautiful feature bullet descriptions",
      "type": "object",
      "properties": {
        "prices": {
          "type": "object",
          "properties": {
            "monthly": { "type": "number" },
            "6months": { "type": "number" },
            "1year": { "type": "number" }
          }
        },
        "features": {
          "type": "array"
        }
      }
    },
    "BatchReview": {
      "title": "Batch Review",
      "description": "Student rating and feedback review for an exam batch course",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "batchId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["batchId", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "ExamViolation": {
      "title": "Live Exam Violation Log",
      "description": "Student live exam tab switch and focus blur violation log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "exam_attempt_id": { "type": "string" },
        "student_id": { "type": "string" },
        "student_name": { "type": "string" },
        "student_email": { "type": "string" },
        "exam_id": { "type": "string" },
        "exam_title": { "type": "string" },
        "violation_type": { "type": "string" },
        "violation_count": { "type": "integer" },
        "max_allowed": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["exam_attempt_id", "student_id", "exam_id", "violation_type", "violation_count", "timestamp"]
    },
    "LiveExamReExamPermission": {
      "title": "Live Exam Re-Exam Permission",
      "description": "Administrative permission grant for a student to retake a live model test",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "examTitle": { "type": "string" },
        "grantedBy": { "type": "string" },
        "grantedByName": { "type": "string" },
        "grantedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "used", "revoked"] },
        "notes": { "type": "string" }
      },
      "required": ["examId", "userId", "grantedBy", "status", "grantedAt"]
    },
    "PracticeAttempt": {
      "title": "Practice Attempt Record",
      "description": "Student practice quiz attempt log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "chapter": { "type": "string" },
        "score": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "score", "totalQuestions", "createdAt"]
    },
    "NotificationLog": {
      "title": "Notification Broadcast Log",
      "description": "System broadcast notification event record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string" },
        "targetType": { "type": "string" },
        "recipientCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "createdAt"]
    },
    "OurHero": {
      "title": "Our Hero Achiever",
      "description": "Student achievement profile for the Hall of Fame / Our Heroes showcase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "college": { "type": "string" },
        "meritRank": { "type": "string" },
        "score": { "type": "string" },
        "session": { "type": "string" },
        "hscBatch": { "type": "string" },
        "photoUrl": { "type": "string" },
        "quote": { "type": "string" },
        "badge": { "type": "string" },
        "featured": { "type": "boolean" },
        "order": { "type": "integer" },
        "tags": { "type": "array" }
      },
      "required": ["name", "college"]
    }
  },
  "firestore": {
    "our_heroes": {
      "schema": "OurHero",
      "description": "Stores successful medical student achievers, their ranks, college, quotes and achievements"
    },
    "batch_reviews": {
      "schema": "BatchReview",
      "description": "Stores student star ratings and reviews for exam batches"
    },
    "live_exam_reexam_permissions": {
      "schema": "LiveExamReExamPermission",
      "description": "Stores granted re-exam permissions allowing students to retake auto-submitted or failed live tests"
    },
    "practice_attempts": {
      "schema": "PracticeAttempt",
      "description": "Stores student practice quiz attempt records"
    },
    "notification_logs": {
      "schema": "NotificationLog",
      "description": "Stores system notification distribution records"
    },
    "mentor_queries": {
      "schema": "MentorQuery",
      "description": "Stores user questions to their mentor and corresponding responses"
    },
    "mark_predictions": {
      "schema": "MarkPrediction",
      "description": "Stores student details and predicted marks evaluation from admin"
    },
    "users": {
      "schema": "User",
      "description": "Stores user records, profiles, and progression metrics"
    },
    "users/{userId}/incorrect_questions/{questionId}": {
      "schema": "Question",
      "description": "Stores chapter-wise incorrect questions answered by the user across all modes"
    },
    "questions": {
      "schema": "Question",
      "description": "Stores chapter-wise multiple choice questions with explanations"
    },
    "battles": {
      "schema": "Battle",
      "description": "Active game combat practice runs for survival and boss modes"
    },
    "posts": {
      "schema": "Post",
      "description": "Social feed entries shared by medical aspirants"
    },
    "squads": {
      "schema": "Squad",
      "description": "Study squads/teams of medical preparation aspirants"
    },
    "squads/{squadId}/messages": {
      "schema": "SquadMessage",
      "description": "Real-time messages and shared resources inside a Study Squad"
    },
    "notices": {
      "schema": "Notice",
      "description": "Admin platform announcements and Bangladesh medical admission notifications"
    },
    "settings": {
      "schema": "PlatformSettings",
      "description": "System level controls and configuration"
    },
    "enrollments": {
      "schema": "Enrollment",
      "description": "Tracks course enrollments, subscription details, and manual payments"
    },
    "live_exams": {
      "schema": "LiveExam",
      "description": "Stores live exam configurations"
    },
    "live_exams/{examId}/reviews/{reviewId}": {
      "schema": "BatchReview",
      "description": "Sub-collection storing student star ratings and reviews for an exam batch"
    },
    "live_exam_submissions": {
      "schema": "LiveExamSubmission",
      "description": "Stores student live exam test results and leaderboard standings"
    },
    "payment_requests": {
      "schema": "PaymentRequest",
      "description": "Stores user submitted manual payment requests for subscription verification"
    },
    "user_notifications": {
      "schema": "UserNotification",
      "description": "Stores real-time in-app notifications for users"
    },
    "advertisements": {
      "schema": "Advertisement",
      "description": "Stores popup and banner advertisement campaigns"
    },
    "ad_analytics_events": {
      "schema": "AdAnalyticsEvent",
      "description": "Stores individual click and impression events for ads analytics"
    },
    "exam_violations": {
      "schema": "ExamViolation",
      "description": "Stores student live exam tab switch and focus blur violation logs for anti-cheating auditing"
    },
    "course_promocodes": {
      "schema": "PromoCode",
      "description": "Stores course promo codes and coupon discounts"
    },
    "game_questions": {
      "schema": "Question",
      "description": "Stores gamified medical MCQ questions for gaming arena games"
    }
  }
}
